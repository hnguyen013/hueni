# Copy file này thành .env (KHÔNG commit .env thật lên git) nếu muốn test
# cấu hình "giống production" ở máy local, hoặc dùng làm tham chiếu khi
# nhập Environment Variables trên Render/Railway.
#
# Ở local (dev bình thường): KHÔNG cần file .env này — mọi biến đều có giá
# trị mặc định an toàn trong config/settings.py.

# --- Bắt buộc khi DJANGO_DEBUG=False (production) ---
DJANGO_SECRET_KEY=doi-thanh-chuoi-ngau-nhien-dai-it-nhat-50-ky-tu
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=ten-app.onrender.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://ten-app.onrender.com

# --- Database (production — Render tự cấp khi tạo Postgres) ---
DATABASE_URL=postgres://user:password@host:5432/dbname

# --- Tuỳ chọn: bật lưu media (ảnh/file upload) lên S3 thay vì đĩa tạm ---
USE_S3_MEDIA=False
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=ap-southeast-1

# --- Tuỳ chọn: tắt ép chuyển HTTPS (chỉ dùng khi debug lỗi redirect loop) ---
# DJANGO_SECURE_SSL_REDIRECT=True
